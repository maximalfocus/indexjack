{
  "format": "indexjack-source-policy/1",
  "sources": [
    {
      "id": "glasswing-private",
      "role": "private",
      "url": "http://packages.private.example:8080"
    },
    {
      "id": "community-public-shadow",
      "role": "public",
      "url": "http://packages-shadow.public.example:8080"
    }
  ],
  "mappings": [
    {
      "pattern": "@glasswing/*",
      "mode": "exclusive",
      "source": "glasswing-private"
    },
    {
      "pattern": "community-*",
      "mode": "exclusive",
      "source": "community-public-shadow"
    }
  ]
}
